# 웨비나 신청폼 → Google Apps Script 연동에 필요한 서버 전용 환경변수.
# 실제 값은 .env.local(gitignore 처리됨)에 채워넣을 것 — 이 파일엔 절대 실제 값을 넣지 말 것.

# Apps Script를 "웹 앱"으로 배포한 뒤 나오는 /exec 로 끝나는 URL (편집기 URL이 아님)
GAS_WEBINAR_WEBAPP_URL=

# Apps Script 프로젝트 설정 > 스크립트 속성에 같은 키로 등록해둔 공유 시크릿
GAS_WEBINAR_SHARED_SECRET=

# 이중 저장(백업)용 Supabase — 문의폼(app/api/inquiry)과 같은 프로젝트/키를 그대로 재사용하면 됨
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 신청 확인 메일 발송용 Resend — hr.assesta.com 도메인이 인증된 계정의 API 키 (Sending access)
RESEND_API_KEY=
# 운영과 동일하게 noreply@hr.assesta.com 으로 설정 (mail.piccle.ai는 Resend에 인증되어 있지 않음)
RESEND_FROM_EMAIL=noreply@hr.assesta.com

# 자료집 신청(/seminar/downloadform) → 별도 Apps Script 웹앱 (개발일지/download-form/gas-download.gs)
GAS_DOWNLOAD_WEBAPP_URL=
GAS_DOWNLOAD_SHARED_SECRET=
